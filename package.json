{
  "name": "neuraldesk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Fullstack AI Workflow Intelligence Platform",
  "author": "NeuralDesk Team",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @neuraldesk/web dev",
    "dev:api": "pnpm --filter @neuraldesk/api dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:puppeteer": "tsx tests/puppeteer/runner.ts",
    "test:manual-audit": "tsx scripts/manual-browser-audit.ts",
    "db:generate": "pnpm --filter @neuraldesk/db db:generate",
    "db:migrate": "pnpm --filter @neuraldesk/db db:migrate",
    "db:seed": "pnpm --filter @neuraldesk/db db:seed",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "@playwright/test": "^1.65.1",
    "@types/supertest": "^6.0.2",
    "hono": "^4.6.10",
    "prettier": "^3.3.3",
    "puppeteer": "^25.17.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "overrides": {
      "tinypool": ">=2.1.2",
      "drizzle-orm": ">=0.45.2",
      "@hono/node-server": ">=2.1.8",
      "uuid": ">=11.1.1",
      "vitest": ">=3.2.6",
      "vite": ">=6.4.4",
      "esbuild": ">=0.25.0",
      "zod": ">=4.6.6"
    }
  }
}
