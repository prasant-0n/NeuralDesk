# ==============================================================================
# NeuralDesk — Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Server Configuration (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Connection (packages/db)
# Neon Serverless PostgreSQL (Recommended for production):
#   postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# Turso SQLite (Optional local/edge alternative):
#   libsql://[database]-[user].turso.io
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuraldesk_dev
DATABASE_AUTH_TOKEN=
DATABASE_POOL_SIZE=10

# ------------------------------------------------------------------------------
# 3. AI Providers
# Google Gemini API Key (Get a free key from https://aistudio.google.com/):
# Required for Live Gemini Mode (Flash 1.5/2.0, Pro 1.5).
# If omitted or running in offline mode, NeuralDesk uses the Deterministic Mock Engine.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# Optional: Local Offline LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 4. Security & Cryptography
# JWT_SECRET: Minimum 32-character random string for signing auth tokens
# ENCRYPTION_KEY: 32-byte (64-character hex) key for AES-256-GCM BYOK encryption
# WEBHOOK_SIGNING_SECRET: Default shared secret for HMAC-SHA256 ingress
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEBHOOK_SIGNING_SECRET=whsec_sample_secret_key_for_local_testing

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (apps/web)
# Exposes variables prefixed with VITE_ to the browser client bundle.
# NEVER put private API keys or secrets in VITE_* variables!
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001/api/v1
VITE_APP_NAME="NeuralDesk"
VITE_DEFAULT_THEME=dark

# ------------------------------------------------------------------------------
# 6. Concurrency & Rate Limiting (Free-Tier Protection)
# MAX_CONCURRENT_EXECUTIONS: Max simultaneous workflows on Node.js process
# EXECUTION_TIMEOUT_MS: Maximum allowed runtime per node (default: 30000ms)
# ------------------------------------------------------------------------------
MAX_CONCURRENT_EXECUTIONS=3
EXECUTION_TIMEOUT_MS=30000
