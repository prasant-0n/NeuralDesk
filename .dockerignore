# ==============================================================================
# NeuralDesk — Docker Build Ignore Rules
# Excludes local state, secrets, dependencies, logs, and test artifacts
# ==============================================================================

# Dependencies
node_modules
**/node_modules

# Git & VCS
.git
.gitignore
.github

# Environment & Secrets (Zero-Leak Security Boundary)
.env
.env.*
!.env.example

# Build & Compilation Artifacts
dist
**/dist
build
.next
.turbo
.vite

# Test Artifacts, Coverage & Reports
coverage
test-results
playwright-report
.nyc_output

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS Metadata
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Documentation & Scratch Files
docs
*.md
